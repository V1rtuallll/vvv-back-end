[Unit]
Description=V1rtual Spring Boot backend
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/vvv-back-end
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=SPRING_CONFIG_ADDITIONAL_LOCATION=file:/etc/v1rtual/application-prod.yml
ExecStart=/www/server/java/jdk-21.0.2/bin/java -Xms256M -Xmx1024M -jar /www/wwwroot/vvv-back-end/current/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
