spring:
  datasource:
    url: jdbc:mysql://__DB_HOST__:3306/vvv?useSSL=true&serverTimezone=UTC
    username: __DB_USERNAME__
    password: __DB_PASSWORD__
  servlet:
    multipart:
      max-file-size: 100MB
      max-request-size: 500MB

aliyun:
  oss:
    endpoint: __OSS_ENDPOINT__
    access-key-id: __OSS_ACCESS_KEY_ID__
    access-key-secret: __OSS_ACCESS_KEY_SECRET__
    bucket-name: __OSS_BUCKET_NAME__

jwt:
  secret: __JWT_SECRET_BASE64URL__
  expiration: 604800000
